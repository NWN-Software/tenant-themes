<?php

namespace {{ namespace }};

use Filament\Panel;
use Hasnayeen\Themes\Contracts\CanModifyPanelConfig;
use Hasnayeen\Themes\Contracts\Theme;

class {{ class }} implements CanModifyPanelConfig, Theme
{
    public static function getName(): string
    {
        return '{{ name }}';
    }

    /**
     * Ruta absoluta al CSS compilado del tema (usado internamente).
     */
    public static function getPath(): string
    {
        return resource_path('css/filament/{{ panel }}/themes/{{ name }}.css');
    }

    /**
     * Ruta pública al CSS compilado del tema relativa a /public.
     * Requerida por Filament v4+.
     */
    public static function getPublicPath(): string
    {
        return 'css/filament/{{ panel }}/themes/{{ name }}.css';
    }

    public function getThemeColor(): array
    {
        return [
            'primary' => '#ffffff',
        ];
    }

    public function modifyPanelConfig(Panel $panel): Panel
    {
        return $panel
            ->{{ method }}($this->getPath());
    }
}
